# =============================================================================
# S.I.R.I.S. — Smart Intelligence for Real Time Investigation Support
# Master Project Environment Configuration Template
# Copy this file to '.env' at the repository root for local development.
# DO NOT COMMIT THE ACTUAL '.env' FILE OR ANY API KEYS TO GIT REPOSITORIES.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SPRING BOOT CORE PLATFORM & SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=4c8b9d3f5e1a7c2b8e4f0a9d3c5e7b1a9f0e2d4c6b8a0e2f4a6c8b0d2e4f6a8b
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 2. PRIMARY CLOUD REASONING PROVIDER (GROQ API)
# -----------------------------------------------------------------------------
# Primary LLM provider across AI modules: groq | ollama | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEYS=your_groq_key1_here,your_groq_key2_here,your_groq_key3_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SINGLE SOURCE OF TRUTH)
# -----------------------------------------------------------------------------
# Spring Boot Operational Relational Database (Dev default: H2 memory, Prod: PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:h2:mem:crimelens_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Supabase / PostgreSQL Production URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/crimelens_db

# Neo4j Graph Database (Central Intelligence Engine)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ChromaDB Vector Store (FIR/BNS Legal Intelligence)
CHROMA_DB_PATH=ml/fir-bns-rag/chroma_db_bge_m3

# -----------------------------------------------------------------------------
# 4. SERVICE ARCHITECTURE URLs
# -----------------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8080
ML_GATEWAY_URL=http://localhost:8000
ML_CENTRAL_INTEL_URL=http://localhost:8000
ML_FIR_BNS_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# 5. LOCAL / OFFLINE LLM FALLBACK (OLLAMA)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# 6. GEMINI LIVE GATEWAY (NODE.JS SERVER - VOICE & EPHEMERAL TOKENS)
# -----------------------------------------------------------------------------
SERVER_PORT=3001
GOOGLE_API_KEY=your_google_gemini_api_key_here

# -----------------------------------------------------------------------------
# 7. FIR / BNS & OCR MODULE SPECIFIC CONFIGURATION
# -----------------------------------------------------------------------------
TESSERACT_CMD=
BNS_PDF_PATH=documents/BNSS_2023.pdf
