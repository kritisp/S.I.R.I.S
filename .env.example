# ==============================================================================
# S.I.R.I.S — AIRA Intelligence Gemini Live Configuration Example
# ==============================================================================

# Google Gemini API Key (Server-side secret only; never exposed to frontend)
GOOGLE_API_KEY=your_google_gemini_api_key

# Backend Server Port
SERVER_PORT=3001

# Frontend direct Gemini API Key (Optional fallback for production deployments where backend token server is not hosted)
VITE_GEMINI_API_KEY=your_google_gemini_api_key

# Backend Token URL (Used in local dev or deployed server)
VITE_GEMINI_TOKEN_URL=http://localhost:3001/api/gemini/live-token

# ==============================================================================
# S.I.R.I.S — Core Spring Boot Backend Configuration
# ==============================================================================
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crimelens_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# JWT Security Configuration (HMAC-SHA Key of at least 256 bits)
JWT_SECRET=4c8b9d3f5e1a7c2b8e4f0a9d3c5e7b1a9f0e2d4c6b8a0e2f4a6c8b0d2e4f6a8b
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Machine Learning Adapters Configuration
ML_SERVICE_URL=http://localhost:8000
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
