VITE_INTEL_SERVICE_URL=http://localhost:8000/api/v1/graph
VITE_RAG_API_URL=http://localhost:8001
VITE_GEMINI_TOKEN_URL=http://localhost:3001/api/gemini/live-token
# VITE_INTERNAL_API_KEY, VITE_BHASINI_API_KEY, VITE_BHASINI_UDYAT_KEY, VITE_GROQ_API_KEY,
